{
  "name": "tatva-work-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "check:env": "tsx --env-file=.env scripts/check-env.ts",
    "test:e2e": "tsx --env-file=.env scripts/e2e.ts",
    "test": "tsx --test test/*.test.ts",
    "seed:contacts": "tsx --env-file=.env scripts/seed-contacts.ts",
    "tunnel": "tsx --env-file=.env scripts/tunnel.ts",
    "test:voice": "tsx --env-file=.env scripts/voice-demo.ts",
    "seed:demo-meetings": "tsx --env-file=.env --env-file=../.env.local scripts/demo-meetings.ts"
  },
  "dependencies": {
    "@composio/core": "^0.30.0",
    "@huggingface/transformers": "^4.3.2",
    "@supabase/supabase-js": "^2.119.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.5.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
