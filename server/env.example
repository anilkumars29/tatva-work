# Tatva Work server — copy to server/.env and fill in. Never commit .env.
# (Named env.example, not .env.example, because the root .gitignore ignores .env*.)

# Supabase (Dashboard -> Project Settings -> API Keys). Server-side only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Composio (https://platform.composio.dev). Google Docs must be connected for user "hack_user".
COMPOSIO_API_KEY=

# ---- Optional (defaults shown) ----
# PORT=4000
# COMPOSIO_USER_ID=hack_user
# SUPABASE_AUDIO_BUCKET=meeting-audio
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# GROQ_WHISPER_LANGUAGE=en          # empty = auto-detect
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# WHISPER_MAX_BYTES=25165824        # files above this are split into chunks
# WHISPER_CHUNK_SECONDS=600
# LLM_MAX_TRANSCRIPT_CHARS=18000    # longer transcripts are extracted in parts, then merged
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# MAX_UPLOAD_BYTES=209715200
