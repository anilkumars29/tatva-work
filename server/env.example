# Tatva Work server — copy to server/.env and fill in. Never commit .env.
# (Named env.example, not .env.example, because the root .gitignore ignores .env*.)

# Supabase (Dashboard -> Project Settings -> API Keys). Server-side only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Composio (https://platform.composio.dev). Google Docs must be connected for user "hack_user".
COMPOSIO_API_KEY=

# Voice agent (Milestone 3). Shared secret Agora sends as the bearer token to
# POST /v1/chat/completions; set the same value as CUSTOM_LLM_API_KEY in the root
# .env.local. The endpoint is disabled while this is empty.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
VOICE_LLM_API_KEY=

# Demo contacts for `pnpm run seed:contacts` (kept here so addresses stay out of git).
# DEMO_CONTACT_EMAIL=crewmate.0007@gmail.com   # Priya, Meera
# DEMO_OWNER_EMAIL=you@example.com             # Rahul, Anil ("email me")

# ---- Optional (defaults shown) ----
# VOICE_LLM_MODEL=openai/gpt-oss-120b
# VOICE_LLM_FALLBACK_MODELS=openai/gpt-oss-20b   # tried on 429 (each model has its own TPM budget)
# VOICE_LLM_REASONING_EFFORT=low
# VOICE_LLM_MAX_TOKENS=500
# SLACK_CHANNEL=#hack
# TRACKER_SHEET_NAME=Tatva Tracker           # found in Drive, created if missing
# TRACKER_SPREADSHEET_ID=                    # skip the Drive search
# PORT=4000
# COMPOSIO_USER_ID=hack_user
# SUPABASE_AUDIO_BUCKET=meeting-audio
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# GROQ_WHISPER_LANGUAGE=en          # empty = auto-detect
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# WHISPER_MAX_BYTES=25165824        # files above this are split into chunks
# WHISPER_CHUNK_SECONDS=600
# LLM_MAX_TRANSCRIPT_CHARS=10000    # longer transcripts are extracted in parts, then merged
# LLM_MAX_COMPLETION_TOKENS=6000   # max output budget per extraction call (reasoning + JSON)
# GROQ_LLM_TPM_LIMIT=8000           # your Groq tokens-per-minute limit (raise on Dev Tier)
# GROQ_LLM_REASONING_EFFORT=medium  # low | medium | high (high hits free-tier rate limits)
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# MAX_UPLOAD_BYTES=209715200
