# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Murf Falcon TTS (BYOK)
# Required: Murf API key. Server-side only. Never expose this in client code.
MURF_API_KEY=

# Required: Murf voice ID for an en-IN voice (e.g. the "Pooja" voice ID)
MURF_VOICE_ID=

# Required: Murf voice style supported by that voice (e.g. Conversational)
MURF_VOICE_STYLE=

# Tatva voice agent: custom LLM served by server/ (POST /v1/chat/completions).
# Optional. `pnpm run tunnel` in server/ writes CUSTOM_LLM_URL (cloudflared quick
# tunnel; the URL changes every run). Unset = managed gpt-4o-mini, no tools.
CUSTOM_LLM_URL=
# Must equal VOICE_LLM_API_KEY in server/.env. Server-side only.
CUSTOM_LLM_API_KEY=

# Deployment only (see docs/DEPLOY.md). Unset locally = no login, /tatva proxied to localhost:4000.
# TATVA_ACCESS_CODE=        # the login code (also typed into the extension)
# TATVA_SERVER_KEY=         # shared secret with server/ (Render)
# TATVA_SERVER_URL=https://tatva-server.onrender.com
