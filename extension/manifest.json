{
  "manifest_version": 3,
  "name": "Tatva Recorder",
  "description": "Records a browser meeting (tab audio + your microphone) and sends it to Tatva.",
  "version": "0.5.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "downloads",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.onrender.com/*",
    "http://localhost:4000/*",
    "http://127.0.0.1:4000/*"
  ],
  "action": {
    "default_title": "Tatva Recorder",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://*.vercel.app/*"
      ],
      "js": [
        "page-marker.js"
      ],
      "run_at": "document_start"
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
