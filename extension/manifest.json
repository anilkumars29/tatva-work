{
  "manifest_version": 3,
  "name": "Tatva Work Recorder",
  "description": "Records a browser meeting (tab audio + your microphone) and sends it to Tatva Work.",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "offscreen",
    "downloads",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:4000/*"
  ],
  "action": {
    "default_title": "Tatva Work Recorder",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}
